<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_set_form" model="ir.ui.view">
        <field name="model">product.set</field>
        <field name="inherit_id" ref="sale_product_set.view_product_set_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="before">
                <field name="is_kit"/>
                <field name="product_template_id"
                    attrs="{'invisible': [('is_kit', '!=', True)], 'required': [('is_kit', '=', True)]}"
                />
            </xpath>

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="attrs">{"invisible": [("product_template_id", "!=", False)]}</attribute>
            </xpath>

            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="attrs">{"invisible": [("product_template_id", "!=", False)]}</attribute>
            </xpath>

            <xpath expr="//tree/field[@name='discount']" position="after">
                <field name="percent_price" sum="Total Percent"/>
            </xpath>
        </field>
    </record>
</odoo>
