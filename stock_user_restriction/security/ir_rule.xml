<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_stock_picking_type_restriction" model="ir.rule">
        <field name="name">rule_stock_picking_type_restriction</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="groups" eval="[(4, ref('group_stock_picking_type_restriction'))]"/>
        <field name="domain_force">[('id', 'in', [picking_type_id.id for picking_type_id in user.picking_type_ids])]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
