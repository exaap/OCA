<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_form" model="ir.ui.view">
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock.view_inventory_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//tree" position="inside">
                <field name="initial_position" readonly="1"/>
                <field name="final_position" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_inventory_form_group" model="ir.ui.view">
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="view_inventory_form"/>
        <field name="groups_id"
            eval="[(4, ref('stock_location_position_product.group_stock_location_position_manager'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//tree/field[@name='initial_position']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <xpath expr="//field[@name='line_ids']//tree/field[@name='final_position']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
