<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <field name="inventory_diff_quantity" position="after">
                <field name="initial_position" readonly="1"/>
                <field name="final_position" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable_group" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="view_stock_quant_tree_inventory_editable"/>
        <field name="groups_id"
            eval="[(4, ref('stock_location_position_product.group_stock_location_position_manager'))]"/>
        <field name="arch" type="xml">
            <field name="initial_position" position="attributes">
                <attribute name="readonly">0</attribute>
            </field>

            <field name="final_position" position="attributes">
                <attribute name="readonly">0</attribute>
            </field>
        </field>
    </record>
</odoo>
