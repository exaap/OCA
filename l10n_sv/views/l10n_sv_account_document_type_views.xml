<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_sv_account_document_type_tree" model="ir.ui.view">
        <field name="model">l10n_sv_account.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="l10n_sv_account_document_type_form" model="ir.ui.view">
        <field name="model">l10n_sv_account.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Types">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_sv_account_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_sv_account.document.type</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="l10n_sv_account_document_type_menu" name="Document Types"
        action="l10n_sv_account_document_type_action" parent="l10n_sv.l10n_sv_account_document_main" sequence="2"/>
</odoo>
