<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_l10n_sv_account_document_manager" model="res.groups">
        <field name="name">Documents Manager</field>
        <field name="category_id" ref="base.module_category_localization"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_l10n_sv_account_document_unlink" model="res.groups">
        <field name="name">Unlink Documents</field>
        <field name="implied_ids" eval="[(4, ref('group_l10n_sv_account_document_manager'))]"/>
        <field name="category_id" ref="base.module_category_localization"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
