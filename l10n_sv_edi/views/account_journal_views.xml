<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account_move_name_sequence.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="dte_document_type_id"/>
            </field>

            <field name="refund_sequence_id" position="after">
                <field name="debitnote_sequence" attrs="{'invisible': [('type', 'not in', ['sale', 'purchase'])]}"/>
                <field
                    name="debitnote_sequence_id"
                    attrs="{
                        'invisible': ['|', ('type', 'not in', ('sale', 'purchase')), ('debitnote_sequence', '=', False)],
                        'required': [('type', 'in', ('sale', 'purchase')), ('debitnote_sequence', '=', True)]
                    }"
                    context="{
                        'default_name': name,
                        'default_company_id': company_id,
                        'default_implementation': 'no_gap',
                        'default_padding': 4,
                        'default_use_date_range': True,
                        'default_prefix': 'D' + (code or 'UNKNOWN') + '/%%(range_year)s/'
                    }"
                />
            </field>
        </field>
    </record>
</odoo>
