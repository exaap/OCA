#. module: l10n_sv_edi
#: model:mail.template,body_html:l10n_sv_edi.mail_template_dte_error
msgid ""
"<div class=\"text-center\" style=\"font-size: 13px; font-family: Arial, sans-serif; color: #333;\">\n"
"                <img t-att-src=\"'/logo.png?company=%s' % (object.company_id.id or 0)\">\n"
"                <p>\n"
"                    <span>Review the Electronic Tax Document:</span>\n"
"                    <strong>\n"
"                        <t t-out=\"object.dte_control_number\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p>Best regards,</p>\n"
"                <p>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div class=\"text-center\" style=\"box-sizing:border-box;text-align:center;font-size: 13px; font-family: Arial, sans-serif; color: #333;\">\n"
"                <img t-att-src=\"'/logo.png?company=%s' % (object.company_id.id or 0)\" style=\"box-sizing:border-box;vertical-align:middle;\">\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Revisar el Documento Tributario Electrónico:\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.dte_control_number\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Atentamente,</p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: l10n_sv_edi
#: model:mail.template,body_html:l10n_sv_edi.mail_template_dte
msgid ""
"<div class=\"text-center\" style=\"font-size: 13px; font-family: Arial, sans-serif; color: #333;\">\n"
"                <img t-att-src=\"'/logo.png?company=%s' % (object.company_id.id or 0)\">\n"
"                <p>Dear customer</p>\n"
"                <p>\n"
"                    <strong>\n"
"                        <t t-out=\"object.partner_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p>\n"
"                    <span>Receive a cordial greeting from</span>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"                <p>\n"
"                    <span>We send you the</span>\n"
"                    <strong>Electronic Tax Document,</strong>\n"
"                    <span>in JSON and PDF format, as required by current tax regulations.</span>\n"
"                </p>\n"
"                <p>This document has been validated by the General Directorate of Internal Revenue (DGII).</p>\n"
"\n"
"                <br>\n"
"\n"
"                <p>Best regards,</p>\n"
"                <p>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"                <p>\n"
"                    <span>\n"
"                        <t t-out=\"object.company_id.street\"></t>\n"
"                    </span>\n"
"                    <span>\n"
"                        <t t-out=\"object.company_id.street2\"></t>\n"
"                    </span>\n"
"                    <span>\n"
"                        <t t-out=\"object.company_id.partner_id.district_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p>\n"
"                    <span>If you have any questions regarding your DTE, please contact us at the email:</span>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.email\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div class=\"text-center\" style=\"box-sizing:border-box;text-align:center;font-size: 13px; font-family: Arial, sans-serif; color: #333;\">\n"
"                <img t-att-src=\"'/logo.png?company=%s' % (object.company_id.id or 0)\" style=\"box-sizing:border-box;vertical-align:middle;\">\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Apreciable cliente</p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.partner_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Reciba un cordial saludo de\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Le remitimos el\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">Documento Tributario Electrónico,</strong>\n"
"                    en formato JSON y PDF, según lo requerido en la normativa tributaria vigente.\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Este documento ha sido validado por la Dirección General de Impuestos Internos (DGII).</p>\n"
"\n"
"                <br>\n"
"\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Atentamente,</p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    \n"
"                        <t t-out=\"object.company_id.street\"></t>\n"
"                    \n"
"                    \n"
"                        <t t-out=\"object.company_id.street2\"></t>\n"
"                    \n"
"                    \n"
"                        <t t-out=\"object.company_id.partner_id.district_id.name\"></t>\n"
"                    \n"
"                </p>\n"
"\n"
"                <br>\n"
"\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    En caso de consultas respecto a tu DTE, por favor contactarnos al correo electronico:\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.company_id.email\"></t>\n"
"                    </strong>\n"
"                </p>\n"
"            </div>\n"
"        "

