<?xml version="1.0"?>
<odoo noupdate="1">
    <record id="cron_update_list_price" model="ir.cron">
        <field name="name">Update List Price</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="state">code</field>
        <field name="code">model.action_update_list_price()</field>
        <field name="interval_number">1</field>
        <field name="nextcall" eval="(DateTime.today()).strftime('%Y-%m-%d 06:00:00')"/>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
