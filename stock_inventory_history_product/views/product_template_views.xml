<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_user')])]"/>
        <field name="arch" type="xml">
            <group name="inventory" position="after">
                <group string="Inventory">
                    <field name="last_inventory_date"/>
                    <field name="inventory_line_ids">
                        <tree create="0" delete="0" edit="0">
                            <field name="inventory_adjustment_id"/>
                            <field name="date"/>
                            <field name="state"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="previous_inventory_quantity"/>
                            <field name="counted_inventory_quantity"/>
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
