<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_city_zip_zone_groups_form" model="ir.ui.view">
        <field name="model">res.city.zip.zone.groups</field>
        <field name="arch" type="xml">
            <form>
                <group col="4">
                    <field name="name"/>
                </group>
                <group>
                    <field name="zone_ids" widget='many2many_list'/>
                </group>
            </form>
        </field>
    </record>

    <record id="res_city_zip_zone_groups_tree" model="ir.ui.view">
        <field name="model">res.city.zip.zone.groups</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zone_ids"/>
            </tree>
        </field>
    </record>

    <record id="res_city_zip_zone_groups_action" model="ir.actions.act_window">
        <field name="name">Zone Groups</field>
        <field name="res_model">res.city.zip.zone.groups</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="res_city_zip_zone_groups_tree"/>
    </record>

    <menuitem id="res_city_zip_zone_root_menu" name="Zones" parent="base.menu_custom"/>

    <menuitem id="res_city_zip_zone_groups_menu" name="Zone Groups" action="res_city_zip_zone_groups_action"
        parent="res_city_zip_zone_root_menu"/>
</odoo>
