<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_city_zip_zone_form" model="ir.ui.view">
        <field name="model">res.city.zip.zone</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="zip_id"/>
                    </group>
                </group>
                <group>
                    <field name="district_ids" widget='many2many_list'/>
                </group>
            </form>
        </field>
    </record>

    <record id="res_city_zip_zone_tree" model="ir.ui.view">
        <field name="model">res.city.zip.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zip_id"/>
                <field name="district_ids"/>
            </tree>
        </field>
    </record>

    <record id="res_city_zip_zone_action" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">res.city.zip.zone</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="res_city_zip_zone_tree"/>
    </record>

    <menuitem id="res_city_zip_zone_menu" name="Zones" action="res_city_zip_zone_action"
        parent="res_city_zip_zone_root_menu"/>
</odoo>