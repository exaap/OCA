<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_job_position" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_contact_job_position.view_partner_form_job_position"/>
        <field name="arch" type="xml">
            <field name="phone" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <field name="phone_extension" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <field name="mobile" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <field name="email" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <field name="website" position="before">
                <field name="contact_point_ids">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="type"/>
                        <field name="name"/>
                        <field name="phone_extension"/>
                        <field name="contact_name"/>
                        <field name="job_position_id"/>
                    </tree>
                </field>
            </field>
        </field>
    </record>
</odoo>
